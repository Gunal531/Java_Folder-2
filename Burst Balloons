
class Solution {
    public int maxCoins(int[] nums) {
        int n = nums.length;

        // Add virtual balloons with value 1 at both ends
        int[] a = new int[n + 2];
        a[0] = 1;
        a[n + 1] = 1;

        for (int i = 0; i < n; i++) {
            a[i + 1] = nums[i];
        }

        // dp[left][right] = maximum coins between boundaries
        int[][] dp = new int[n + 2][n + 2];

        // gap is the distance between the two boundaries
        for (int gap = 2; gap < n + 2; gap++) {
            for (int left = 0; left + gap < n + 2; left++) {
                int right = left + gap;

                // Choose the last balloon to burst
                for (int k = left + 1; k < right; k++) {
                    int coins = dp[left][k]
                              + dp[k][right]
                              + a[left] * a[k] * a[right];

                    dp[left][right] =
                        Math.max(dp[left][right], coins);
                }
            }
        }

        return dp[0][n + 1];
    }
}
