
import java.util.*;

class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {

        // Store nums1 elements
        Set<Integer> set1 = new HashSet<>();

        for (int num : nums1) {
            set1.add(num);
        }

        // Store common elements
        Set<Integer> result = new HashSet<>();

        for (int num : nums2) {
            if (set1.contains(num)) {
                result.add(num);
            }
        }

        // Convert HashSet into int array
        int[] answer = new int[result.size()];

        int index = 0;

        for (int num : result) {
            answer[index++] = num;
        }

        return answer;
    }
}
