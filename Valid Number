class Solution {
    public boolean isNumber(String s) {
        boolean digitSeen = false;
        boolean dotSeen = false;
        boolean exponentSeen = false;
        boolean digitAfterExponent = true;

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            if (Character.isDigit(c)) {
                digitSeen = true;

                if (exponentSeen) {
                    digitAfterExponent = true;
                }

            } else if (c == '.') {
                // Dot cannot appear after exponent or more than once
                if (dotSeen || exponentSeen) {
                    return false;
                }

                dotSeen = true;

            } else if (c == 'e' || c == 'E') {
                // Exponent needs a number before it
                // and can appear only once
                if (exponentSeen || !digitSeen) {
                    return false;
                }

                exponentSeen = true;
                digitAfterExponent = false;

            } else if (c == '+' || c == '-') {
                // Sign is valid only at the beginning
                // or immediately after e/E
                if (i != 0 &&
                    s.charAt(i - 1) != 'e' &&
                    s.charAt(i - 1) != 'E') {
                    return false;
                }

            } else {
                return false;
            }
        }

        return digitSeen && digitAfterExponent;
    }
}
