
import java.util.PriorityQueue;
import java.util.Collections;

class MedianFinder {

    // Max-heap: stores the smaller half
    private PriorityQueue<Integer> lower;

    // Min-heap: stores the larger half
    private PriorityQueue<Integer> upper;

    public MedianFinder() {
        lower = new PriorityQueue<>(Collections.reverseOrder());
        upper = new PriorityQueue<>();
    }

    public void addNum(int num) {

        // Add the number to the lower half first
        lower.offer(num);

        // Ensure the largest lower value belongs in the upper half
        upper.offer(lower.poll());

        // Keep the lower heap at least as large as the upper heap
        if (lower.size() < upper.size()) {
            lower.offer(upper.poll());
        }
    }

    public double findMedian() {

        // Odd number of elements
        if (lower.size() > upper.size()) {
            return lower.peek();
        }

        // Even number of elements
        return ((double) lower.peek() + upper.peek()) / 2.0;
    }
}
